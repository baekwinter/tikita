{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "질문 인식 데이터 (bot/data/questions.json) — 정답 없음",
  "type": "object",
  "required": [
    "lexicon",
    "questions"
  ],
  "properties": {
    "lexicon": {
      "type": "object",
      "required": [
        "aliases",
        "concepts"
      ],
      "properties": {
        "aliases": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "concepts": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "stop_phrases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "canonical_question",
          "match"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^Q-[A-Z0-9-]+$"
          },
          "canonical_question": {
            "type": "string"
          },
          "accepted_variations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "match": {
            "type": "object",
            "properties": {
              "entity_sets": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "concepts": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "optional": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "subject": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "not_subject": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "subject_strict": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}