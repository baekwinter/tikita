[Unit]
Description=달빛 방송부 웹 조사실 (Next.js)
After=network-online.target dalbit-api.service

[Service]
Type=simple
User=dalbit
WorkingDirectory=/opt/dokeun-motion-webtoon/web
Environment=NODE_ENV=production
Environment=API_ORIGIN=http://127.0.0.1:8000
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
