# =====================================================================
# 도근고등학교 달빛 방송부 — 봇 & 웹 API 공용 환경 변수
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 Git 에 올리지 않습니다.
# =====================================================================

# --- Discord 봇 (Developer Portal > Bot > Reset Token) ------------------
DISCORD_TOKEN=
# Developer Portal > General Information > Application ID (초대 링크 생성에 사용)
DISCORD_APPLICATION_ID=

# --- 운영진 --------------------------------------------------------------
# 운영진 2명의 디스코드 사용자 ID (쉼표 구분). 개발자 모드 > 프로필 우클릭 > ID 복사
DG_ADMIN_USER_IDS=
# 운영진 역할 ID (선택, 쉼표 구분)
DG_ADMIN_ROLE_IDS=
# '서버 관리' 권한 보유자도 운영 명령어를 쓸 수 있게 할지 (기본 true)
DG_ADMIN_ALLOW_MANAGE_GUILD=true
# 운영 알림을 받을 비공개 운영진 채널 ID (선택. 비우면 운영진에게 DM)
DG_ADMIN_ALERT_CHANNEL_ID=

# --- 저장소 --------------------------------------------------------------
# 봇과 웹 API 가 같은 파일을 공유해야 한다 (기본: bot/var/dalbit.db)
DG_DB_PATH=var/dalbit.db

# --- 웹 조사실 링크 (디스코드 버튼에 표시) ------------------------------
DG_WEB_URL=

# --- 웹 API (FastAPI) ----------------------------------------------------
# Developer Portal > OAuth2 > Client ID / Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 웹 조사실 공개 주소 (끝에 / 없이). OAuth2 Redirect 는 {DG_PUBLIC_URL}/api/auth/callback
DG_PUBLIC_URL=http://localhost:3000
# 세션 쿠키 서명 키: python -c "import secrets;print(secrets.token_urlsafe(48))"
DG_SESSION_SECRET=

# --- 선택: AI 질문 해석 보조 --------------------------------------------
# 규칙 기반 해석이 실패했을 때만, 공개된 질문 목록 중 같은 뜻을 고르는 데 쓴다. 정답은 AI 에게 주지 않는다.
DG_AI_ENABLED=false
ANTHROPIC_API_KEY=
DG_AI_MODEL=claude-opus-5

# --- 테스트 (별도 테스트 서버에서만) -------------------------------------
# DG_TEST_MODE=true 이면 아래 테스트 서버/채널을 쓰고, 개막 시각을 앞당길 수 있다.
# 실제 도근도근 서버 ID 로는 개막 시각 변경이 거부된다.
DG_TEST_MODE=false
DG_TEST_GUILD_ID=
DG_TEST_CHANNEL_ID=
DG_TEST_START_AT=
# 로컬 개발용 웹 로그인(/api/auth/dev). 테스트 모드에서만 동작.
DG_WEB_DEV_LOGIN=false
